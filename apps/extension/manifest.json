{
  "manifest_version": 3,
  "name": "SafePick 상품 정보 보내기",
  "version": "0.6.0",
  "description": "현재 쇼핑몰 상품 페이지의 공개 정보를 확인하고 로컬 SafePick으로 전달합니다.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8081/*", "http://localhost:8082/*"],
  "action": { "default_popup": "popup.html", "default_title": "SafePick으로 분석" }
}
